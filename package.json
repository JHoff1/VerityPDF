{
  "name": "verity-pdf",
  "private": true,
  "version": "0.1.28",
  "homepage": "https://www.veritypdf.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JHoff1/VerityPDF.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test accessibility.spec.ts",
    "test:performance": "playwright test performance.spec.ts",
    "downloads": "node ./scripts/show-downloads.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "store:assets:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-store-assets.ps1",
    "brand:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-brand-assets.ps1",
    "store:demo-pdf": "node ./scripts/create-store-demo-pdf.mjs",
    "store:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1",
    "store:msix:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-msix.ps1 -Architecture arm64",
    "store:wack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-store-package.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
